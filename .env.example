# Copy to .env and fill in. NEVER commit .env.
# (settings.py now reads ONLY these names - the old .env keys are ignored.)

# --- Django ---
DJANGO_DEBUG=False
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=shanzee.com,www.shanzee.com,200.97.169.190,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://shanzee.com,https://www.shanzee.com
SITE_URL=https://shanzee.com
# Set False only if nginx already redirects http -> https
DJANGO_SECURE_SSL_REDIRECT=True

# --- Database (PostgreSQL) ---
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email (Hostinger SMTP) - put the NEW password here after changing it ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=True
SMTP_USE_TLS=False
SMTP_USER=admin@shanzee.com
SMTP_PASSWORD=
SMTP_FROM=shanzee@shanzee.com
ADMIN_EMAIL=admin@shanzee.com

# --- Redis (Celery broker, cache for rate limits, chat channel layer) ---
REDIS_URL=redis://127.0.0.1:6379/0
# Leave empty to use REDIS_URL
CELERY_BROKER_URL=
# Without REDIS_URL tasks run inline (dev only). Force with True/False:
# CELERY_TASK_ALWAYS_EAGER=False

# --- Couriers ---
# Encrypts courier API keys in the database. Generate ONCE and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you lose/change it you must re-enter courier credentials.
COURIER_ENCRYPTION_KEY=
COURIER_POLL_MINUTES=30
COURIER_TRACK_MAX_DAYS=45
# True only if behind nginx that sets X-Forwarded-For (for webhook IP allow-lists)
COURIER_TRUST_X_FORWARDED_FOR=False

# --- Rate limiting behind nginx (login / OTP) ---
# With nginx: proxy_set_header X-Real-IP $remote_addr;  then use:
# RATELIMIT_IP_META_KEY=HTTP_X_REAL_IP
RATELIMIT_IP_META_KEY=REMOTE_ADDR
